<?xml version="1.0" encoding="utf-8"?>
<!-- FUTURE REVIEW TEMPLATE: requires URL Rewrite + approved ARR proxy configuration.
     No verified static artifact exists. Configure HTTPS, MIME types and ACLs separately. -->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <rewrite>
      <rules>
        <rule name="Brokerage ASP.NET API" stopProcessing="true">
          <match url="^api(?:/(.*))?$" />
          <action type="Rewrite" url="http://127.0.0.1:5000/{R:0}" />
        </rule>
        <rule name="Exported HTML only" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  <location path="site-bootstrap.json">
    <system.webServer>
      <httpProtocol><customHeaders><add name="Cache-Control" value="no-store" /></customHeaders></httpProtocol>
    </system.webServer>
  </location>
</configuration>
<!-- No private-storage virtual directory. Backend sets private/public-settings no-store headers.
     Directory/index export and old dynamic deep-link compatibility require separate proof. -->
